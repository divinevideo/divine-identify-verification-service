{
  "name": "divine-identity-verification-service",
  "version": "1.0.0",
  "description": "NIP-39 external identity claim verification service for divine ecosystem",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:production": "node scripts/production-release.mjs",
    "build:vendor": "node scripts/build-browser-vendor.mjs",
    "check:vendor": "node scripts/build-browser-vendor.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:once": "vitest run",
    "test:contract": "vitest run src/contract"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@scure/base": "^2.0.0",
    "hono": "^4.10.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "esbuild": "0.28.2",
    "nostr-tools": "2.23.3",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12",
    "wrangler": "4.160.1"
  }
}
