{
  "name": "divine-identity-verification-service",
  "version": "1.0.0",
  "description": "NIP-39 external identity claim verification service for divine ecosystem",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "predeploy": "npm run check:vendor",
    "deploy": "wrangler deploy",
    "build:vendor": "node scripts/build-browser-vendor.mjs",
    "check:vendor": "node scripts/build-browser-vendor.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:once": "vitest run"
  },
  "type": "commonjs",
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@scure/base": "^2.0.0",
    "hono": "^4.10.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.20251115.0",
    "esbuild": "0.27.3",
    "nostr-tools": "2.23.3",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
